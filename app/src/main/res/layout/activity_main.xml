<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#F7F4FF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="StudyMate" android:textColor="#6C63FF" android:textSize="30sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Teman belajar dan pengingat tugasmu." android:textColor="#77748B"
            android:textSize="15sp" android:layout_marginTop="8dp" android:layout_marginBottom="28dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Login" android:textColor="#24213A" android:textSize="25sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Masuk untuk melanjutkan aktivitas belajarmu." android:textColor="#77748B"
            android:layout_marginTop="6dp" android:layout_marginBottom="20dp"/>
        <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="56dp"
            android:hint="Email" android:inputType="textEmailAddress" android:padding="14dp"
            android:background="@drawable/input_bg"/>
        <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="56dp"
            android:hint="Password" android:inputType="textPassword" android:padding="14dp"
            android:layout_marginTop="12dp" android:background="@drawable/input_bg"/>
        <TextView android:id="@+id/tvForgot" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Lupa password?" android:textColor="#6C63FF" android:layout_gravity="end"
            android:paddingTop="14dp" android:paddingBottom="14dp"/>
        <Button android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Login" android:textAllCaps="false" android:textColor="#FFFFFF"
            android:backgroundTint="#6C63FF"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Belum punya akun?" android:textColor="#77748B" android:layout_gravity="center"
            android:layout_marginTop="18dp"/>
        <Button android:id="@+id/btnRegister" android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Buat akun baru" android:textAllCaps="false" android:textColor="#6C63FF"
            android:backgroundTint="#E9E6FF" android:layout_marginTop="4dp"/>
    </LinearLayout>
</ScrollView>